#!/usr/bin/env bash
# Fast repository checks before each commit.
#
# Enabled with `make hooks`, which sets core.hooksPath=.githooks.
# Generation/build testing is intentionally excluded; run `make harness`
# before pushing template changes.

set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

if ! command -v python3 >/dev/null 2>&1; then
  echo "pre-commit: python3 not found, skipping checks" >&2
  exit 0
fi

if command -v make >/dev/null 2>&1; then
  exec make --no-print-directory check
fi

exec python3 scripts/check_repo.py --strict
